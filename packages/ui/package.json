{
    "type": "module",
    "name": "@yeelds/ui",
    "version": "0.1.0",
    "license": "MIT",
    "description": "Yeelds design system: theme tokens and shared React components.",
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./style.css": "./dist/style.css",
        "./theme.css": "./dist/theme.css"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "mkdir -p dist && cp src/theme.css dist && vite build && tsc -b --force",
        "lint": "eslint . && prettier --check .",
        "format": "eslint --fix . && prettier --write .",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build"
    },
    "peerDependencies": {
        "react": "catalog:",
        "react-dom": "catalog:"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.20",
        "classnames": "catalog:",
        "motion": "^13.1.0",
        "react-use": "^17.6.1",
        "react-window": "^2.3.0"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.3.0",
        "@eslint/js": "catalog:",
        "@storybook/addon-docs": "^10.5.7",
        "@storybook/addon-onboarding": "^10.5.7",
        "@storybook/react-vite": "^10.5.7",
        "@tailwindcss/postcss": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "eslint": "catalog:",
        "eslint-config-prettier": "catalog:",
        "eslint-plugin-storybook": "^10.5.7",
        "prettier": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "storybook": "^10.5.7",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "typescript-eslint": "catalog:",
        "vite": "catalog:"
    },
    "eslintConfig": {
        "extends": [
            "plugin:storybook/recommended"
        ]
    }
}
