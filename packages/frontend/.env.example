# Which backend deployment to talk to: "development" or "production". The
# hostnames themselves live in @yeelds/sdk's SERVICE_URLS, not here.
#
# Read exclusively through src/commons/env.ts. Adding a NEXT_PUBLIC_* var here
# also means adding it to turbo.json's build.env array.
NEXT_PUBLIC_ENVIRONMENT=development

# Umami website id for analytics. Read through src/commons/env.ts.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Bearer token sent to the real Yeelds backend. Server-only - never exposed to
# the browser. Read through src/commons/env.ts, consumed only by
# src/commons/server.ts (used by the src/app/api/[...endpoint] proxy route).
YEELDS_API_TOKEN=
