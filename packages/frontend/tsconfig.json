{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "allowJs": true,
        "noEmit": true,
        "incremental": true,
        "types": ["node"],
        "plugins": [{ "name": "next" }],
        "paths": {
            "@/*": ["./*", "./src/*"]
        }
    },
    "include": [
        "next-env.d.ts",
        "global.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
